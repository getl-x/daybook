{
  "name": "@daybook/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "daybook 后端：Fastify + PostgreSQL（Node 24 直跑 TypeScript，无构建步骤）",
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch src/index.ts",
    "migrate": "node src/db/migrate.ts",
    "user": "node src/cli/user.ts",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "fastify": "^5.12.3",
    "pg": "^8.23.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "typescript": "^5.9.3"
  }
}
