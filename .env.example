# daybook 环境变量示例：复制成 .env 后改成自己的值
#   cp .env.example .env
#   chmod 600 .env
#
# 注意：.env 不进仓库、不进镜像（见 .gitignore / .dockerignore）。

# —— 数据库 ——
# 给 compose 里的 postgres 容器用（也是 app 拼 DATABASE_URL 用的口令）
POSTGRES_PASSWORD=换成一个长随机串

# —— 应用 ——
# 生产环境至少 32 个字符；生成：openssl rand -base64 48
JWT_SECRET=换成一个至少 32 字符的随机串
# 容器内监听端口，默认 8090（反代指向它）
PORT=8090
# development | test | production
NODE_ENV=production
# trace | debug | info | warn | error | silent
LOG_LEVEL=info

# —— Web Push（阶段 3 才需要；不配则提醒功能不可用，服务照常启动）——
# 生成：npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
