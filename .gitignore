# 默认全部忽略，只放行下面显式批准的内容。
#
# 好处：将来在根目录随手建的脚本/草稿/数据不会被误提交；坏处：新增顶层目录时要记得加放行。
# 与 .dockerignore 保持同样的白名单思路。

/*

# 策略本体
!/.gitignore

# —— 全部应用源码 ——
!/source/
!/source/**
# 依赖与产物永不入库
/source/**/node_modules/
/source/**/dist/
/source/**/coverage/
/source/**/test-results/
/source/**/playwright-report/
/source/**/.vite/
/source/**/.cache/
/source/**/*.tsbuildinfo
# 本地密钥与原生端签名文件
/source/**/.env
/source/**/.env.*
!/source/**/.env.example
/source/**/*.jks
/source/**/*.keystore
/source/**/keystore.properties

# —— 根目录的入口文档与编排 ——
!/README.md
!/README.zh-CN.md
!/DAYBOOK-DESIGN.zh-CN.md
!/LICENSE
!/SECURITY.md
!/Dockerfile
!/Dockerfile.*
!/.dockerignore
!/compose.yml
!/compose.yaml
!/compose.*.yml
!/compose.*.yaml
!/docker-compose.yml
!/docker-compose.yaml
!/docker-compose.*.yml
!/docker-compose.*.yaml

# —— 部署输入物 ——
!/deploy/
!/deploy/**
# 真实 env 与备份产物仍然忽略，只放行示例
/deploy/.env
/deploy/*.env
!/deploy/*.env.example

# —— 文档（按语言分目录）——
!/docs/
/docs/*
!/docs/zh-CN/
!/docs/zh-CN/**
!/docs/en/
!/docs/en/**

# —— GitHub Actions（放行 CI 与两个发布流程）——
!/.github/
/.github/*
!/.github/ISSUE_TEMPLATE/
!/.github/ISSUE_TEMPLATE/**
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/ci.yml
!/.github/workflows/docker-publish.yml
!/.github/workflows/android-release.yml

# —— 本地密钥与运行数据（永不入库）——
/.env
/.env.*
/backups/
*.dump
*.sql.gz
